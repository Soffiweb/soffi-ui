{
    "name": "soffiweb/soffi-ui",
    "description": "Soffi UI — fuente unica de estilos para las apps Soffiweb. CSS/JS plano, sin Bootstrap, Popper, jQuery ni Node.",
    "type": "library",
    "license": "proprietary",
    "keywords": ["soffiweb", "design-system", "laravel", "blade", "css"],
    "require": {
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "php": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "Soffiweb\\SoffiUi\\": "src-php/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Soffiweb\\SoffiUi\\SoffiUiServiceProvider"
            ]
        }
    },
    "scripts": {
        "build": "php scripts/build.php",
        "check-compat": "php scripts/check-compat.php",
        "test": "phpunit --configuration phpunit.xml.dist"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
